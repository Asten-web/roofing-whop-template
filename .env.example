# Public website configuration (safe for client-side use)
VITE_COMPANY_NAME=Your Roofing Company
VITE_COMPANY_PHONE_DISPLAY=(555) 555-0100
VITE_COMPANY_PHONE_TEL=+15555550100
VITE_COMPANY_EMAIL=hello@example.com
VITE_COMPANY_CITY=Your City
VITE_COMPANY_STATE=ST
VITE_SERVICE_AREA=Your City and nearby communities
VITE_COMPANY_ADDRESS=Your City, ST
VITE_BUSINESS_HOURS=Set your business hours
VITE_COMPANY_LOGO=/icons/company-logo.svg
VITE_HERO_IMAGE=
VITE_DEMO_CONTENT=true
VITE_BRAND_NAVY=#12243a
VITE_BRAND_ORANGE=#e8742b
VITE_LICENSE_LINE=

# Public Whop identifiers and checkout configuration.
# These IDs are visible to website visitors; never put API keys in VITE_ variables.
VITE_WHOP_ACCOUNT_ID=
VITE_WHOP_LEAD_PRODUCT_ID=
VITE_WHOP_INSPECTION_PLAN_ID=
VITE_WHOP_DEPOSIT_PLAN_ID=
VITE_WHOP_REPAIR_PLAN_ID=
VITE_WHOP_SANDBOX=true

# Server settings.
# Whop Websites supplies WHOP_ACCOUNT_ID, WHOP_API_ORIGIN, and signed API access.
# `whop apps dev` injects WHOP_API_KEY locally. For plain `npm run dev`, obtain
# your account ID and a sandbox API key from Whop. Never expose or commit keys.
WHOP_ACCOUNT_ID=
WHOP_API_ORIGIN=
WHOP_API_BASE_URL=
WHOP_API_KEY=
WHOP_COMPANY_API_KEY=
WHOP_SANDBOX=true
WHOP_API_VERSION_DATE=
APP_URL=
WHOP_ADMIN_KEY=
ROOFING_ADMIN_KEY=
WHOP_LEAD_PRODUCT_ID=
